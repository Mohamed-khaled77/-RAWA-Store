generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Audience {
  GIRLS
  BOYS
  UNISEX
}

enum Role {
  CUSTOMER
  ADMIN
}

model Category {
  id       String    @id @default(cuid())
  name     String
  nameEn   String?
  emoji    String
  products Product[]
}

model Product {
  id            String          @id @default(cuid())
  name          String
  nameEn        String?
  price         Int
  discountPrice Int?
  description   String?
  descriptionEn String?
  stock         Int             @default(10)
  audience      Audience
  imageUrl      String?
  images        String[]        @default([])
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id])
  reviews       ProductReview[]
  favorites     Favorite[]
  orderItems    OrderItem[]
  damagedItems  DamagedItem[]
  createdAt     DateTime        @default(now())
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([customerId, productId])
}

model Order {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  total      Int
  status     String      @default("pending") // pending, paid, shipped, delivered, return_requested, returned
  createdAt  DateTime    @default(now())
  returnRequests ReturnRequest[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
}

model Customer {
  id       String         @id @default(cuid())
  numericId Int           @unique @default(autoincrement())
  name     String
  phone    String         @unique
  email    String?
  password String
  address  String?
  avatarUrl String?
  role     Role           @default(CUSTOMER)
  isVip    Boolean        @default(false)
  lastNameChangedAt DateTime?
  orders   Order[]
  reviews  ProductReview[]
  favorites Favorite[]
}

model OfferBanner {
  id          String   @id @default(cuid())
  title       String
  titleEn     String?
  subtitle    String?
  subtitleEn  String?
  buttonText  String?
  buttonTextEn String?
  imageUrl    String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ReturnRequest {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  reason    String
  status    String   @default("pending") // pending, approved, rejected, completed
  createdAt DateTime @default(now())
}

model DamagedItem {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  reason    String
  createdAt DateTime @default(now())
}
